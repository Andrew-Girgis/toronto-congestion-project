---
// The only way a slide shows a number: display text and its tag, both from figures.json.
import { fig, tagKind, tagText } from "../lib/data";
interface Props { id: string; tag?: boolean; class?: string }
const { id, tag = true, class: cls = "" } = Astro.props;
const f = fig(id);
---
<span class={`figwrap ${cls}`}><span class="fig" data-fig={id}>{f.display}</span>{tag && <span class={`tag ${tagKind(f.label)}`} title={f.label}>{tagText(f.label)}</span>}</span>
